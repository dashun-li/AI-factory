# ===========================================
# AI Video Factory - Environment Variables
# ===========================================

# ---- Application ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aifactory
POSTGRES_PASSWORD=aifactory_dev
POSTGRES_DB=ai_video_factory

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- MinIO (Object Storage) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-video-factory

# ---- Milvus (Vector Database) ----
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=

# ---- OpenAI ----
OPENAI_API_KEY=

# ---- AI Service Endpoints ----
FASTER_WHISPER_URL=http://localhost:9001
WHISPERX_URL=http://localhost:9002
COSYVOICE_URL=http://localhost:9003

# ---- External APIs ----
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
KLING_API_KEY=
FAL_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3000
